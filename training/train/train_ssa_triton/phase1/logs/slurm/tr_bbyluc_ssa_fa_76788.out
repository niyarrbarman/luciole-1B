[rank8]:E0211 11:43:16.694000 1000477 torch/_inductor/runtime/triton_heuristics.py:515]     HQ = 24
[rank8]:E0211 11:43:16.694000 1000477 torch/_inductor/runtime/triton_heuristics.py:515]     Q_LEN = 1024
[rank8]:E0211 11:43:16.694000 1000477 torch/_inductor/runtime/triton_heuristics.py:515]     ZKV = 8
[rank8]:E0211 11:43:16.694000 1000477 torch/_inductor/runtime/triton_heuristics.py:515]     KV_LEN = 1024
[rank8]:E0211 11:43:16.694000 1000477 torch/_inductor/runtime/triton_heuristics.py:515] 
