[rank4]:E0211 11:43:16.730000 3173919 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank4]:E0211 11:43:16.730000 3173919 torch/_inductor/runtime/triton_heuristics.py:515]     # We support two cases for batch dimension. a) (ZKV == ZQ) where off_zkv = off_zq.
[rank4]:E0211 11:43:16.730000 3173919 torch/_inductor/runtime/triton_heuristics.py:515]     # b) (ZKV == 1 and ZQ > 1) where KV is broadcasted along the batch dimension and off_zkv=0.
[rank4]:E0211 11:43:16.730000 3173919 torch/_inductor/runtime/triton_heuristics.py:515]     off_zkv = off_zq % ZKV
[rank4]:E0211 11:43:16.730000 3173919 torch/_inductor/runtime/triton_heuristics.py:515]     off_hkv = off_hq // GQA_SHARED_HEADS
[rank4]:E0211 11:43:16.730000 3173919 torch/_inductor/runtime/triton_heuristics.py:515]     off_g = off_hq % GQA_SHARED_HEADS
[rank4]:E0211 11:43:16.730000 3173919 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank4]:E0211 11:43:16.730000 3173919 torch/_inductor/runtime/triton_heuristics.py:515]     q_offset = off_zq * stride_qz + off_hq * stride_qh
[rank4]:E0211 11:43:16.730000 3173919 torch/_inductor/runtime/triton_heuristics.py:515]     k_offset = off_zkv * stride_kz + off_hkv * stride_kh
[rank4]:E0211 11:43:16.730000 3173919 torch/_inductor/runtime/triton_heuristics.py:515]     v_offset = off_zkv * stride_vz + off_hkv * stride_vh
[rank4]:E0211 11:43:16.730000 3173919 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank4]:E0211 11:43:16.730000 3173919 torch/_inductor/runtime/triton_heuristics.py:515]     Q = Q + q_offset
[rank4]:E0211 11:43:16.730000 3173919 torch/_inductor/runtime/triton_heuristics.py:515]     K = K + k_offset
[rank4]:E0211 11:43:16.730000 3173919 torch/_inductor/runtime/triton_heuristics.py:515]     V = V + v_offset
[rank4]:E0211 11:43:16.730000 3173919 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank4]:E0211 11:43:16.730000 3173919 torch/_inductor/runtime/triton_heuristics.py:515]     SPARSE_Z = 8
[rank4]:E0211 11:43:16.730000 3173919 torch/_inductor/runtime/triton_heuristics.py:515]     SPARSE_HQ = 24
[rank4]:E0211 11:43:16.730000 3173919 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank4]:E0211 11:43:16.730000 3173919 torch/_inductor/runtime/triton_heuristics.py:515]     sparse_idx_z = off_zq % SPARSE_Z
[rank4]:E0211 11:43:16.730000 3173919 torch/_inductor/runtime/triton_heuristics.py:515]     sparse_idx_hq = off_hq % SPARSE_HQ
[rank4]:E0211 11:43:16.730000 3173919 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank4]:E0211 11:43:16.730000 3173919 torch/_inductor/runtime/triton_heuristics.py:515]     SPARSE_Q_MULTIPLE: tl.constexpr = (SPARSE_Q_BLOCK_SIZE // BLOCK_M)
[rank4]:E0211 11:43:16.730000 3173919 torch/_inductor/runtime/triton_heuristics.py:515]     SPARSE_KV_MULTIPLE: tl.constexpr = (SPARSE_KV_BLOCK_SIZE // BLOCK_N)
[rank4]:E0211 11:43:16.730000 3173919 torch/_inductor/runtime/triton_heuristics.py:515] 
