[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     MATMUL_PRECISION = Q.dtype.element_ty
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     q_start = tl.program_id(0)
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     off_zq = tl.program_id(1) // HQ
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     off_hq = tl.program_id(1) % HQ
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     # We support two cases for batch dimension. a) (ZKV == ZQ) where off_zkv = off_zq.
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     # b) (ZKV == 1 and ZQ > 1) where KV is broadcasted along the batch dimension and off_zkv=0.
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     off_zkv = off_zq % ZKV
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     off_hkv = off_hq // GQA_SHARED_HEADS
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     off_g = off_hq % GQA_SHARED_HEADS
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     q_offset = off_zq * stride_qz + off_hq * stride_qh
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     k_offset = off_zkv * stride_kz + off_hkv * stride_kh
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     v_offset = off_zkv * stride_vz + off_hkv * stride_vh
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     Q = Q + q_offset
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     K = K + k_offset
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     V = V + v_offset
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     SPARSE_Z = 8
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     SPARSE_HQ = 24
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     sparse_idx_z = off_zq % SPARSE_Z
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     sparse_idx_hq = off_hq % SPARSE_HQ
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     SPARSE_Q_MULTIPLE: tl.constexpr = (SPARSE_Q_BLOCK_SIZE // BLOCK_M)
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     SPARSE_KV_MULTIPLE: tl.constexpr = (SPARSE_KV_BLOCK_SIZE // BLOCK_N)
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     stride_kv_num_blks_h = 8
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     stride_kv_idx_h = 64
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     stride_kv_idx_m = 8
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     # initialize pointer to m and l
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     m_i = tl.zeros([BLOCK_M], dtype=tl.float32) - float("inf")
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     l_i = tl.zeros([BLOCK_M], dtype=tl.float32)
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     acc = tl.zeros([BLOCK_M, V_HEAD_DIM_ROUNDED], dtype=tl.float32)
