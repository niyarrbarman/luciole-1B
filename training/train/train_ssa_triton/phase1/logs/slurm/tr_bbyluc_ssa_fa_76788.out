[rank1]:E0211 11:43:16.776000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     q_start = tl.program_id(0)
[rank1]:E0211 11:43:16.776000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     off_zq = tl.program_id(1) // HQ
[rank1]:E0211 11:43:16.776000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     off_hq = tl.program_id(1) % HQ
[rank1]:E0211 11:43:16.776000 1374096 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank1]:E0211 11:43:16.776000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     # We support two cases for batch dimension. a) (ZKV == ZQ) where off_zkv = off_zq.
[rank1]:E0211 11:43:16.776000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     # b) (ZKV == 1 and ZQ > 1) where KV is broadcasted along the batch dimension and off_zkv=0.
[rank1]:E0211 11:43:16.776000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     off_zkv = off_zq % ZKV
