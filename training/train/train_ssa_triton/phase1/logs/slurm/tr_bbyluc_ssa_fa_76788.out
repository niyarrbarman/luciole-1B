[rank2]:E0211 11:43:16.646000 123111 torch/_inductor/runtime/triton_heuristics.py:515]     q_start = tl.program_id(0)
[rank2]:E0211 11:43:16.646000 123111 torch/_inductor/runtime/triton_heuristics.py:515]     off_zq = tl.program_id(1) // HQ
[rank2]:E0211 11:43:16.646000 123111 torch/_inductor/runtime/triton_heuristics.py:515]     off_hq = tl.program_id(1) % HQ
[rank2]:E0211 11:43:16.646000 123111 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank2]:E0211 11:43:16.646000 123111 torch/_inductor/runtime/triton_heuristics.py:515]     # We support two cases for batch dimension. a) (ZKV == ZQ) where off_zkv = off_zq.
[rank2]:E0211 11:43:16.646000 123111 torch/_inductor/runtime/triton_heuristics.py:515]     # b) (ZKV == 1 and ZQ > 1) where KV is broadcasted along the batch dimension and off_zkv=0.
[rank2]:E0211 11:43:16.646000 123111 torch/_inductor/runtime/triton_heuristics.py:515]     off_zkv = off_zq % ZKV
[rank2]:E0211 11:43:16.646000 123111 torch/_inductor/runtime/triton_heuristics.py:515]     off_hkv = off_hq // GQA_SHARED_HEADS
[rank2]:E0211 11:43:16.646000 123111 torch/_inductor/runtime/triton_heuristics.py:515]     off_g = off_hq % GQA_SHARED_HEADS
