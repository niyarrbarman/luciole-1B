[rank10]:E0211 11:43:16.591000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # M: Number of queries, N: Number of keys/values, D: Model dimension
[rank10]:E0211 11:43:16.591000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # QK_HEAD_DIM: The dimension of the query and key embeddings
[rank10]:E0211 11:43:16.591000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # V_HEAD_DIM: The dimension of the value embeddings
[rank10]:E0211 11:43:16.591000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # z: Batch size, h: Number of heads, m: Number of queries per head, k: Number of keys per head
[rank10]:E0211 11:43:16.591000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # GQA_SHARED_HEADS: number of query heads sharing one kv head in GQA setups.
[rank10]:E0211 11:43:16.591000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     #
[rank10]:E0211 11:43:16.591000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # The following FULL_* and PARTIAL_* is defined in the block sparse mask grid, rather than the thread block grid.
[rank10]:E0211 11:43:16.591000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # KV_NUM_BLKS: The number of KV blocks (that may or may not require masking) for each query.
[rank10]:E0211 11:43:16.591000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # KV_IDX: The indices of KV blocks (that may or may not require masking) for each query.
[rank10]:E0211 11:43:16.591000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # FULL_KV_NUM_BLKS: The number of fully unmasked KV blocks (so we don't need masking) for each query.
