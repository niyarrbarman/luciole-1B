[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # Define strides of inputs
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     stride_qz, stride_qh, stride_qm, stride_qk = 786432, 32768, 32, 1
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     stride_kz, stride_kh, stride_kn, stride_kk = 262144, 32768, 32, 1
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     stride_vz, stride_vh, stride_vn, stride_vk = 262144, 32768, 32, 1
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     ZQ = 8
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     HQ = 24
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     Q_LEN = 1024
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     ZKV = 8
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     KV_LEN = 1024
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     MATMUL_PRECISION = Q.dtype.element_ty
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     q_start = tl.program_id(0)
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     off_zq = tl.program_id(1) // HQ
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     off_hq = tl.program_id(1) % HQ
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # We support two cases for batch dimension. a) (ZKV == ZQ) where off_zkv = off_zq.
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # b) (ZKV == 1 and ZQ > 1) where KV is broadcasted along the batch dimension and off_zkv=0.
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     off_zkv = off_zq % ZKV
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     off_hkv = off_hq // GQA_SHARED_HEADS
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     off_g = off_hq % GQA_SHARED_HEADS
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     q_offset = off_zq * stride_qz + off_hq * stride_qh
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     k_offset = off_zkv * stride_kz + off_hkv * stride_kh
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     v_offset = off_zkv * stride_vz + off_hkv * stride_vh
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     Q = Q + q_offset
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     K = K + k_offset
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     V = V + v_offset
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     SPARSE_Z = 8
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     SPARSE_HQ = 24
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     sparse_idx_z = off_zq % SPARSE_Z
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     sparse_idx_hq = off_hq % SPARSE_HQ
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     SPARSE_Q_MULTIPLE: tl.constexpr = (SPARSE_Q_BLOCK_SIZE // BLOCK_M)
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     SPARSE_KV_MULTIPLE: tl.constexpr = (SPARSE_KV_BLOCK_SIZE // BLOCK_N)
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     stride_kv_num_blks_h = 8
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     stride_kv_idx_h = 64
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     stride_kv_idx_m = 8
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # initialize pointer to m and l
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     m_i = tl.zeros([BLOCK_M], dtype=tl.float32) - float("inf")
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     l_i = tl.zeros([BLOCK_M], dtype=tl.float32)
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     acc = tl.zeros([BLOCK_M, V_HEAD_DIM_ROUNDED], dtype=tl.float32)
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     offs_m = q_start * BLOCK_M + tl.arange(0, BLOCK_M)
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # KV_IDX and KV_NUM_BLKS are always contiguous.
[rank10]:E0211 11:43:16.797000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     sparse_hz_offset = sparse_idx_z * SPARSE_HQ + sparse_idx_hq
