[rank9]:E0211 11:43:16.842000 1000478 torch/_inductor/runtime/triton_heuristics.py:515]     ZQ = 8
[rank9]:E0211 11:43:16.842000 1000478 torch/_inductor/runtime/triton_heuristics.py:515]     HQ = 24
[rank9]:E0211 11:43:16.842000 1000478 torch/_inductor/runtime/triton_heuristics.py:515]     Q_LEN = 1024
[rank9]:E0211 11:43:16.842000 1000478 torch/_inductor/runtime/triton_heuristics.py:515]     ZKV = 8
[rank9]:E0211 11:43:16.842000 1000478 torch/_inductor/runtime/triton_heuristics.py:515]     KV_LEN = 1024
[rank9]:E0211 11:43:16.842000 1000478 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank9]:E0211 11:43:16.842000 1000478 torch/_inductor/runtime/triton_heuristics.py:515]     MATMUL_PRECISION = Q.dtype.element_ty
[rank9]:E0211 11:43:16.842000 1000478 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank9]:E0211 11:43:16.842000 1000478 torch/_inductor/runtime/triton_heuristics.py:515]     q_start = tl.program_id(0)
[rank9]:E0211 11:43:16.842000 1000478 torch/_inductor/runtime/triton_heuristics.py:515]     off_zq = tl.program_id(1) // HQ
[rank9]:E0211 11:43:16.842000 1000478 torch/_inductor/runtime/triton_heuristics.py:515]     off_hq = tl.program_id(1) % HQ
[rank9]:E0211 11:43:16.842000 1000478 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank9]:E0211 11:43:16.842000 1000478 torch/_inductor/runtime/triton_heuristics.py:515]     # We support two cases for batch dimension. a) (ZKV == ZQ) where off_zkv = off_zq.
[rank9]:E0211 11:43:16.842000 1000478 torch/_inductor/runtime/triton_heuristics.py:515]     # b) (ZKV == 1 and ZQ > 1) where KV is broadcasted along the batch dimension and off_zkv=0.
[rank9]:E0211 11:43:16.842000 1000478 torch/_inductor/runtime/triton_heuristics.py:515]     off_zkv = off_zq % ZKV
[rank9]:E0211 11:43:16.842000 1000478 torch/_inductor/runtime/triton_heuristics.py:515]     off_hkv = off_hq // GQA_SHARED_HEADS
[rank9]:E0211 11:43:16.842000 1000478 torch/_inductor/runtime/triton_heuristics.py:515]     off_g = off_hq % GQA_SHARED_HEADS
