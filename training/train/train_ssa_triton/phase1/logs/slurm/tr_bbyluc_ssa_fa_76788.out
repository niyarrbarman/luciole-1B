[rank10]:E0211 11:43:16.652000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     #
[rank10]:E0211 11:43:16.652000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # Q: Query, K: Key, V: Value
[rank10]:E0211 11:43:16.652000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # M: Number of queries, N: Number of keys/values, D: Model dimension
[rank10]:E0211 11:43:16.652000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # QK_HEAD_DIM: The dimension of the query and key embeddings
[rank10]:E0211 11:43:16.652000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # V_HEAD_DIM: The dimension of the value embeddings
[rank10]:E0211 11:43:16.652000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # z: Batch size, h: Number of heads, m: Number of queries per head, k: Number of keys per head
[rank10]:E0211 11:43:16.652000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # GQA_SHARED_HEADS: number of query heads sharing one kv head in GQA setups.
[rank10]:E0211 11:43:16.652000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     #
[rank10]:E0211 11:43:16.652000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # The following FULL_* and PARTIAL_* is defined in the block sparse mask grid, rather than the thread block grid.
[rank10]:E0211 11:43:16.652000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # KV_NUM_BLKS: The number of KV blocks (that may or may not require masking) for each query.
[rank10]:E0211 11:43:16.652000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # KV_IDX: The indices of KV blocks (that may or may not require masking) for each query.
[rank10]:E0211 11:43:16.652000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # FULL_KV_NUM_BLKS: The number of fully unmasked KV blocks (so we don't need masking) for each query.
[rank10]:E0211 11:43:16.652000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # FULL_KV_IDX: The indices of fully unmasked KV blocks (so we don't need masking) for each query.
[rank10]:E0211 11:43:16.652000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     #
[rank10]:E0211 11:43:16.652000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # OUTPUT_LOGSUMEXP: We only need to store the logsumexp if we require grad
[rank10]:E0211 11:43:16.652000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     #
[rank10]:E0211 11:43:16.652000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # (Modifiable) Performance tuning options
[rank10]:E0211 11:43:16.652000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # BLOCK_M: The thread block size across the seqlen dim of Q.
[rank10]:E0211 11:43:16.652000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # BLOCK_N: Iterate over BLOCK_N across the seqlen dim of K/V in each thread block.
[rank10]:E0211 11:43:16.652000 3289706 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank10]:E0211 11:43:16.652000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # The below are kernel options that can be applied for certain score_mods,
[rank10]:E0211 11:43:16.652000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # or involve a numerics vs. perf tradeoff
[rank10]:E0211 11:43:16.652000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # PRESCALE_QK: Whether to pre-scale QK by 1/sqrt(d) and change of base. Has
[rank10]:E0211 11:43:16.652000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # about 20% more numerical error, but slightly faster.
[rank10]:E0211 11:43:16.652000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # ROWS_GUARANTEED_SAFE: Is it guaranteed that at least one value in each row
[rank10]:E0211 11:43:16.652000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # is not masked out? If so, we can skip an extra safety check
[rank10]:E0211 11:43:16.652000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # BLOCKS_ARE_CONTIGUOUS: Is it guaranteed that all blocks in the mask are
[rank10]:E0211 11:43:16.652000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     # contiguous? If so, we don't need to do an indirect jump for every block
[rank10]:E0211 11:43:16.652000 3289706 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank10]:E0211 11:43:16.652000 3289706 torch/_inductor/runtime/triton_heuristics.py:515]     tl.static_assert(SPARSE_Q_BLOCK_SIZE >= BLOCK_M and SPARSE_Q_BLOCK_SIZE % BLOCK_M == 0)
