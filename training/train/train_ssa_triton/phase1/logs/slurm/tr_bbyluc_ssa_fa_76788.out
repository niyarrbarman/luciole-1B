[rank4]:E0211 11:43:16.730000 3173919 torch/_inductor/runtime/triton_heuristics.py:515]     MATMUL_PRECISION = Q.dtype.element_ty
[rank4]:E0211 11:43:16.730000 3173919 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank4]:E0211 11:43:16.730000 3173919 torch/_inductor/runtime/triton_heuristics.py:515]     q_start = tl.program_id(0)
[rank4]:E0211 11:43:16.730000 3173919 torch/_inductor/runtime/triton_heuristics.py:515]     off_zq = tl.program_id(1) // HQ
