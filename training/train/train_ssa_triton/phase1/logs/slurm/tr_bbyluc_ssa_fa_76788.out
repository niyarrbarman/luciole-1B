[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     ZQ = 8
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     HQ = 24
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     Q_LEN = 1024
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     ZKV = 8
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     KV_LEN = 1024
