[rank4]:E0211 11:43:16.842000 3173919 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank4]:E0211 11:43:16.842000 3173919 torch/_inductor/runtime/triton_heuristics.py:515]     # KV_IDX and KV_NUM_BLKS are always contiguous.
[rank4]:E0211 11:43:16.842000 3173919 torch/_inductor/runtime/triton_heuristics.py:515]     sparse_hz_offset = sparse_idx_z * SPARSE_HQ + sparse_idx_hq
