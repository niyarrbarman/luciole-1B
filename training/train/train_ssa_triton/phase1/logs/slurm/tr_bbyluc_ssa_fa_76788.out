[rank7]:E0211 11:43:16.697000 2379621 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank7]:E0211 11:43:16.697000 2379621 torch/_inductor/runtime/triton_heuristics.py:515]     stride_kv_num_blks_h = 8
