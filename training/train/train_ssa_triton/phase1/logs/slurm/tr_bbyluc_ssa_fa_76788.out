[rank1]:E0211 11:43:16.577000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     stride_kv_idx_h = 64
[rank1]:E0211 11:43:16.577000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     stride_kv_idx_m = 8
[rank1]:E0211 11:43:16.577000 1374096 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank1]:E0211 11:43:16.577000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     # initialize pointer to m and l
[rank1]:E0211 11:43:16.577000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     m_i = tl.zeros([BLOCK_M], dtype=tl.float32) - float("inf")
[rank1]:E0211 11:43:16.577000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     l_i = tl.zeros([BLOCK_M], dtype=tl.float32)
[rank1]:E0211 11:43:16.577000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     acc = tl.zeros([BLOCK_M, V_HEAD_DIM_ROUNDED], dtype=tl.float32)
