[rank11]:E0211 11:43:16.634000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     # The below are kernel options that can be applied for certain score_mods,
[rank11]:E0211 11:43:16.634000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     # or involve a numerics vs. perf tradeoff
[rank11]:E0211 11:43:16.634000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     # PRESCALE_QK: Whether to pre-scale QK by 1/sqrt(d) and change of base. Has
[rank11]:E0211 11:43:16.634000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     # about 20% more numerical error, but slightly faster.
[rank11]:E0211 11:43:16.634000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     # ROWS_GUARANTEED_SAFE: Is it guaranteed that at least one value in each row
[rank11]:E0211 11:43:16.634000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     # is not masked out? If so, we can skip an extra safety check
[rank11]:E0211 11:43:16.634000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     # BLOCKS_ARE_CONTIGUOUS: Is it guaranteed that all blocks in the mask are
[rank11]:E0211 11:43:16.634000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     # contiguous? If so, we don't need to do an indirect jump for every block
[rank11]:E0211 11:43:16.634000 3289707 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank11]:E0211 11:43:16.634000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     tl.static_assert(SPARSE_Q_BLOCK_SIZE >= BLOCK_M and SPARSE_Q_BLOCK_SIZE % BLOCK_M == 0)
[rank11]:E0211 11:43:16.634000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     tl.static_assert(SPARSE_KV_BLOCK_SIZE >= BLOCK_N and SPARSE_KV_BLOCK_SIZE % BLOCK_N == 0)
