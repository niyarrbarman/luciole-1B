[rank8]:E0211 11:43:16.590000 1000477 torch/_inductor/runtime/triton_heuristics.py:515]     Q = Q + q_offset
[rank8]:E0211 11:43:16.590000 1000477 torch/_inductor/runtime/triton_heuristics.py:515]     K = K + k_offset
[rank8]:E0211 11:43:16.590000 1000477 torch/_inductor/runtime/triton_heuristics.py:515]     V = V + v_offset
[rank8]:E0211 11:43:16.590000 1000477 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank8]:E0211 11:43:16.590000 1000477 torch/_inductor/runtime/triton_heuristics.py:515]     SPARSE_Z = 8
[rank8]:E0211 11:43:16.590000 1000477 torch/_inductor/runtime/triton_heuristics.py:515]     SPARSE_HQ = 24
