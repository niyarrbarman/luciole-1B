[rank1]:E0211 11:43:16.577000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     # Define strides of inputs
[rank1]:E0211 11:43:16.577000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     stride_qz, stride_qh, stride_qm, stride_qk = 786432, 32768, 32, 1
[rank1]:E0211 11:43:16.577000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     stride_kz, stride_kh, stride_kn, stride_kk = 262144, 32768, 32, 1
[rank1]:E0211 11:43:16.577000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     stride_vz, stride_vh, stride_vn, stride_vk = 262144, 32768, 32, 1
