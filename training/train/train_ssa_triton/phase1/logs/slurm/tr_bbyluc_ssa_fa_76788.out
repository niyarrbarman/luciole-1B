[rank9]:E0211 11:43:16.842000 1000478 torch/_inductor/runtime/triton_heuristics.py:515]     q_offset = off_zq * stride_qz + off_hq * stride_qh
[rank9]:E0211 11:43:16.842000 1000478 torch/_inductor/runtime/triton_heuristics.py:515]     k_offset = off_zkv * stride_kz + off_hkv * stride_kh
[rank9]:E0211 11:43:16.842000 1000478 torch/_inductor/runtime/triton_heuristics.py:515]     v_offset = off_zkv * stride_vz + off_hkv * stride_vh
[rank9]:E0211 11:43:16.842000 1000478 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank9]:E0211 11:43:16.842000 1000478 torch/_inductor/runtime/triton_heuristics.py:515]     Q = Q + q_offset
[rank9]:E0211 11:43:16.842000 1000478 torch/_inductor/runtime/triton_heuristics.py:515]     K = K + k_offset
[rank9]:E0211 11:43:16.842000 1000478 torch/_inductor/runtime/triton_heuristics.py:515]     V = V + v_offset
[rank9]:E0211 11:43:16.842000 1000478 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank9]:E0211 11:43:16.842000 1000478 torch/_inductor/runtime/triton_heuristics.py:515]     SPARSE_Z = 8
[rank9]:E0211 11:43:16.842000 1000478 torch/_inductor/runtime/triton_heuristics.py:515]     SPARSE_HQ = 24
[rank9]:E0211 11:43:16.842000 1000478 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank9]:E0211 11:43:16.842000 1000478 torch/_inductor/runtime/triton_heuristics.py:515]     sparse_idx_z = off_zq % SPARSE_Z
[rank9]:E0211 11:43:16.842000 1000478 torch/_inductor/runtime/triton_heuristics.py:515]     sparse_idx_hq = off_hq % SPARSE_HQ
[rank9]:E0211 11:43:16.842000 1000478 torch/_inductor/runtime/triton_heuristics.py:515] 
