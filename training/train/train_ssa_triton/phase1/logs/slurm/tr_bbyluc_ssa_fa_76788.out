[rank2]:E0211 11:43:16.646000 123111 torch/_inductor/runtime/triton_heuristics.py:515]     # (Modifiable) Performance tuning options
[rank2]:E0211 11:43:16.646000 123111 torch/_inductor/runtime/triton_heuristics.py:515]     # BLOCK_M: The thread block size across the seqlen dim of Q.
[rank2]:E0211 11:43:16.646000 123111 torch/_inductor/runtime/triton_heuristics.py:515]     # BLOCK_N: Iterate over BLOCK_N across the seqlen dim of K/V in each thread block.
[rank2]:E0211 11:43:16.646000 123111 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank2]:E0211 11:43:16.646000 123111 torch/_inductor/runtime/triton_heuristics.py:515]     # The below are kernel options that can be applied for certain score_mods,
[rank2]:E0211 11:43:16.646000 123111 torch/_inductor/runtime/triton_heuristics.py:515]     # or involve a numerics vs. perf tradeoff
[rank2]:E0211 11:43:16.646000 123111 torch/_inductor/runtime/triton_heuristics.py:515]     # PRESCALE_QK: Whether to pre-scale QK by 1/sqrt(d) and change of base. Has
[rank2]:E0211 11:43:16.646000 123111 torch/_inductor/runtime/triton_heuristics.py:515]     # about 20% more numerical error, but slightly faster.
[rank2]:E0211 11:43:16.646000 123111 torch/_inductor/runtime/triton_heuristics.py:515]     # ROWS_GUARANTEED_SAFE: Is it guaranteed that at least one value in each row
[rank2]:E0211 11:43:16.646000 123111 torch/_inductor/runtime/triton_heuristics.py:515]     # is not masked out? If so, we can skip an extra safety check
