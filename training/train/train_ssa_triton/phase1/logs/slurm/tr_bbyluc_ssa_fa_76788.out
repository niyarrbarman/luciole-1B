[rank1]:E0211 11:43:16.839000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     q_start = tl.program_id(0)
[rank1]:E0211 11:43:16.839000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     off_zq = tl.program_id(1) // HQ
[rank1]:E0211 11:43:16.839000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     off_hq = tl.program_id(1) % HQ
