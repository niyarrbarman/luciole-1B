[rank2]:E0211 11:43:16.646000 123111 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank2]:E0211 11:43:16.646000 123111 torch/_inductor/runtime/triton_heuristics.py:515]     MATMUL_PRECISION = Q.dtype.element_ty
