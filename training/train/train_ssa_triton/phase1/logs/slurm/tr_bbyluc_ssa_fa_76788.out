[rank1]:E0211 11:43:16.776000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     # Define strides of inputs
[rank1]:E0211 11:43:16.776000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     stride_qz, stride_qh, stride_qm, stride_qk = 786432, 32768, 32, 1
