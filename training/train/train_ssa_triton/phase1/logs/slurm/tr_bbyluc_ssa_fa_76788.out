[rank7]:E0211 11:43:16.757000 2379621 torch/_inductor/runtime/triton_heuristics.py:515]     q_start = tl.program_id(0)
[rank7]:E0211 11:43:16.757000 2379621 torch/_inductor/runtime/triton_heuristics.py:515]     off_zq = tl.program_id(1) // HQ
[rank7]:E0211 11:43:16.757000 2379621 torch/_inductor/runtime/triton_heuristics.py:515]     off_hq = tl.program_id(1) % HQ
[rank7]:E0211 11:43:16.757000 2379621 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank7]:E0211 11:43:16.757000 2379621 torch/_inductor/runtime/triton_heuristics.py:515]     # We support two cases for batch dimension. a) (ZKV == ZQ) where off_zkv = off_zq.
[rank7]:E0211 11:43:16.757000 2379621 torch/_inductor/runtime/triton_heuristics.py:515]     # b) (ZKV == 1 and ZQ > 1) where KV is broadcasted along the batch dimension and off_zkv=0.
[rank7]:E0211 11:43:16.757000 2379621 torch/_inductor/runtime/triton_heuristics.py:515]     off_zkv = off_zq % ZKV
[rank7]:E0211 11:43:16.757000 2379621 torch/_inductor/runtime/triton_heuristics.py:515]     off_hkv = off_hq // GQA_SHARED_HEADS
[rank7]:E0211 11:43:16.757000 2379621 torch/_inductor/runtime/triton_heuristics.py:515]     off_g = off_hq % GQA_SHARED_HEADS
[rank7]:E0211 11:43:16.757000 2379621 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank7]:E0211 11:43:16.757000 2379621 torch/_inductor/runtime/triton_heuristics.py:515]     q_offset = off_zq * stride_qz + off_hq * stride_qh
[rank7]:E0211 11:43:16.757000 2379621 torch/_inductor/runtime/triton_heuristics.py:515]     k_offset = off_zkv * stride_kz + off_hkv * stride_kh
[rank7]:E0211 11:43:16.757000 2379621 torch/_inductor/runtime/triton_heuristics.py:515]     v_offset = off_zkv * stride_vz + off_hkv * stride_vh
[rank7]:E0211 11:43:16.757000 2379621 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank7]:E0211 11:43:16.757000 2379621 torch/_inductor/runtime/triton_heuristics.py:515]     Q = Q + q_offset
[rank7]:E0211 11:43:16.757000 2379621 torch/_inductor/runtime/triton_heuristics.py:515]     K = K + k_offset
[rank7]:E0211 11:43:16.757000 2379621 torch/_inductor/runtime/triton_heuristics.py:515]     V = V + v_offset
[rank7]:E0211 11:43:16.757000 2379621 torch/_inductor/runtime/triton_heuristics.py:515] 
