[rank8]:E0211 11:43:16.590000 1000477 torch/_inductor/runtime/triton_heuristics.py:515]     k_offset = off_zkv * stride_kz + off_hkv * stride_kh
[rank8]:E0211 11:43:16.590000 1000477 torch/_inductor/runtime/triton_heuristics.py:515]     v_offset = off_zkv * stride_vz + off_hkv * stride_vh
