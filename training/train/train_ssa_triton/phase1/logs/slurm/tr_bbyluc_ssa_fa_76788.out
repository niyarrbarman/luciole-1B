[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     FULL_KV_NUM_BLKS = arg_FULL_KV_NUM_BLKS
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     FULL_KV_IDX = arg_FULL_KV_IDX
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     # Sub notation for this kernel:
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     #
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     # Q: Query, K: Key, V: Value
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     # M: Number of queries, N: Number of keys/values, D: Model dimension
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     # QK_HEAD_DIM: The dimension of the query and key embeddings
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     # V_HEAD_DIM: The dimension of the value embeddings
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     # z: Batch size, h: Number of heads, m: Number of queries per head, k: Number of keys per head
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     # GQA_SHARED_HEADS: number of query heads sharing one kv head in GQA setups.
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     #
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     # The following FULL_* and PARTIAL_* is defined in the block sparse mask grid, rather than the thread block grid.
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     # KV_NUM_BLKS: The number of KV blocks (that may or may not require masking) for each query.
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     # KV_IDX: The indices of KV blocks (that may or may not require masking) for each query.
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     # FULL_KV_NUM_BLKS: The number of fully unmasked KV blocks (so we don't need masking) for each query.
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     # FULL_KV_IDX: The indices of fully unmasked KV blocks (so we don't need masking) for each query.
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     #
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     # OUTPUT_LOGSUMEXP: We only need to store the logsumexp if we require grad
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     #
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     # (Modifiable) Performance tuning options
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     # BLOCK_M: The thread block size across the seqlen dim of Q.
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     # BLOCK_N: Iterate over BLOCK_N across the seqlen dim of K/V in each thread block.
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     # The below are kernel options that can be applied for certain score_mods,
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     # or involve a numerics vs. perf tradeoff
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     # PRESCALE_QK: Whether to pre-scale QK by 1/sqrt(d) and change of base. Has
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     # about 20% more numerical error, but slightly faster.
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     # ROWS_GUARANTEED_SAFE: Is it guaranteed that at least one value in each row
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     # is not masked out? If so, we can skip an extra safety check
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     # BLOCKS_ARE_CONTIGUOUS: Is it guaranteed that all blocks in the mask are
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     # contiguous? If so, we don't need to do an indirect jump for every block
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     tl.static_assert(SPARSE_Q_BLOCK_SIZE >= BLOCK_M and SPARSE_Q_BLOCK_SIZE % BLOCK_M == 0)
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     tl.static_assert(SPARSE_KV_BLOCK_SIZE >= BLOCK_N and SPARSE_KV_BLOCK_SIZE % BLOCK_N == 0)
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     # Define strides of inputs
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     stride_qz, stride_qh, stride_qm, stride_qk = 786432, 32768, 32, 1
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     stride_kz, stride_kh, stride_kn, stride_kk = 262144, 32768, 32, 1
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     stride_vz, stride_vh, stride_vn, stride_vk = 262144, 32768, 32, 1
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     ZQ = 8
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     HQ = 24
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     Q_LEN = 1024
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     ZKV = 8
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     KV_LEN = 1024
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     MATMUL_PRECISION = Q.dtype.element_ty
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     q_start = tl.program_id(0)
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     off_zq = tl.program_id(1) // HQ
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     off_hq = tl.program_id(1) % HQ
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     # We support two cases for batch dimension. a) (ZKV == ZQ) where off_zkv = off_zq.
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     # b) (ZKV == 1 and ZQ > 1) where KV is broadcasted along the batch dimension and off_zkv=0.
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     off_zkv = off_zq % ZKV
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     off_hkv = off_hq // GQA_SHARED_HEADS
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     off_g = off_hq % GQA_SHARED_HEADS
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     q_offset = off_zq * stride_qz + off_hq * stride_qh
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     k_offset = off_zkv * stride_kz + off_hkv * stride_kh
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     v_offset = off_zkv * stride_vz + off_hkv * stride_vh
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     Q = Q + q_offset
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     K = K + k_offset
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     V = V + v_offset
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     SPARSE_Z = 8
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     SPARSE_HQ = 24
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     sparse_idx_z = off_zq % SPARSE_Z
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     sparse_idx_hq = off_hq % SPARSE_HQ
[rank6]:E0211 11:43:16.561000 2379620 torch/_inductor/runtime/triton_heuristics.py:515] 
