[rank2]:E0211 11:43:16.646000 123111 torch/_inductor/runtime/triton_heuristics.py:515]     ZQ = 8
[rank2]:E0211 11:43:16.646000 123111 torch/_inductor/runtime/triton_heuristics.py:515]     HQ = 24
[rank2]:E0211 11:43:16.646000 123111 torch/_inductor/runtime/triton_heuristics.py:515]     Q_LEN = 1024
[rank2]:E0211 11:43:16.646000 123111 torch/_inductor/runtime/triton_heuristics.py:515]     ZKV = 8
