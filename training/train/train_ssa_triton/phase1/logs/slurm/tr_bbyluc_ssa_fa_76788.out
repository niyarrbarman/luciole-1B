[rank7]:E0211 11:43:16.757000 2379621 torch/_inductor/runtime/triton_heuristics.py:515]     SPARSE_HQ = 24
[rank7]:E0211 11:43:16.757000 2379621 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank7]:E0211 11:43:16.757000 2379621 torch/_inductor/runtime/triton_heuristics.py:515]     sparse_idx_z = off_zq % SPARSE_Z
