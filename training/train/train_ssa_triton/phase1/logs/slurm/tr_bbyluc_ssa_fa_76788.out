[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     # contiguous? If so, we don't need to do an indirect jump for every block
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     tl.static_assert(SPARSE_Q_BLOCK_SIZE >= BLOCK_M and SPARSE_Q_BLOCK_SIZE % BLOCK_M == 0)
[rank11]:E0211 11:43:16.711000 3289707 torch/_inductor/runtime/triton_heuristics.py:515]     tl.static_assert(SPARSE_KV_BLOCK_SIZE >= BLOCK_N and SPARSE_KV_BLOCK_SIZE % BLOCK_N == 0)
