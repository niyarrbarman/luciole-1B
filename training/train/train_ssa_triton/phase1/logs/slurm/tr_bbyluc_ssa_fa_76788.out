[rank1]:E0211 11:43:16.577000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     offs_m = q_start * BLOCK_M + tl.arange(0, BLOCK_M)
[rank1]:E0211 11:43:16.577000 1374096 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank1]:E0211 11:43:16.577000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     # KV_IDX and KV_NUM_BLKS are always contiguous.
