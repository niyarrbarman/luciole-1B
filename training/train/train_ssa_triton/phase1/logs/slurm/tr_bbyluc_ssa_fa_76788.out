[rank4]:E0211 11:43:16.867000 3173919 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank4]:E0211 11:43:16.867000 3173919 torch/_inductor/runtime/triton_heuristics.py:515]     stride_kv_num_blks_h = 8
[rank4]:E0211 11:43:16.867000 3173919 torch/_inductor/runtime/triton_heuristics.py:515]     stride_kv_idx_h = 64
[rank4]:E0211 11:43:16.867000 3173919 torch/_inductor/runtime/triton_heuristics.py:515]     stride_kv_idx_m = 8
