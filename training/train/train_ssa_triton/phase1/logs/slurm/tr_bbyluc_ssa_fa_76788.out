[rank5]:E0211 11:43:16.702000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]         base=Q,
[rank5]:E0211 11:43:16.702000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]         shape=(Q_LEN, QK_HEAD_DIM),
[rank5]:E0211 11:43:16.702000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]         strides=(stride_qm, stride_qk),
[rank5]:E0211 11:43:16.702000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]         offsets=(q_start * BLOCK_M, 0),
[rank5]:E0211 11:43:16.702000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]         block_shape=(BLOCK_M, QK_HEAD_DIM_ROUNDED),
[rank5]:E0211 11:43:16.702000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]         order=(1, 0)
[rank5]:E0211 11:43:16.702000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     )
