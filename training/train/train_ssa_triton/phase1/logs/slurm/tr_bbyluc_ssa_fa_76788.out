[rank4]:E0211 11:43:16.842000 3173919 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank4]:E0211 11:43:16.842000 3173919 torch/_inductor/runtime/triton_heuristics.py:515]     xindex = idx_d + 32*idx_m + 32768*idx_hq + 786432*idx_zq
[rank4]:E0211 11:43:16.842000 3173919 torch/_inductor/runtime/triton_heuristics.py:515]     tl.store(out_ptr0 + (tl.broadcast_to(xindex, acc.shape)), acc, mask)
