[rank4]:E0211 11:43:16.607000 3173919 torch/_inductor/runtime/triton_heuristics.py:515]     # We support two cases for batch dimension. a) (ZKV == ZQ) where off_zkv = off_zq.
[rank4]:E0211 11:43:16.607000 3173919 torch/_inductor/runtime/triton_heuristics.py:515]     # b) (ZKV == 1 and ZQ > 1) where KV is broadcasted along the batch dimension and off_zkv=0.
[rank4]:E0211 11:43:16.607000 3173919 torch/_inductor/runtime/triton_heuristics.py:515]     off_zkv = off_zq % ZKV
