[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     # Sub notation for this kernel:
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     #
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     # Q: Query, K: Key, V: Value
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     # M: Number of queries, N: Number of keys/values, D: Model dimension
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     # QK_HEAD_DIM: The dimension of the query and key embeddings
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     # V_HEAD_DIM: The dimension of the value embeddings
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     # z: Batch size, h: Number of heads, m: Number of queries per head, k: Number of keys per head
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     # GQA_SHARED_HEADS: number of query heads sharing one kv head in GQA setups.
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     #
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     # The following FULL_* and PARTIAL_* is defined in the block sparse mask grid, rather than the thread block grid.
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     # KV_NUM_BLKS: The number of KV blocks (that may or may not require masking) for each query.
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     # KV_IDX: The indices of KV blocks (that may or may not require masking) for each query.
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     # FULL_KV_NUM_BLKS: The number of fully unmasked KV blocks (so we don't need masking) for each query.
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     # FULL_KV_IDX: The indices of fully unmasked KV blocks (so we don't need masking) for each query.
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     #
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     # OUTPUT_LOGSUMEXP: We only need to store the logsumexp if we require grad
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     #
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     # (Modifiable) Performance tuning options
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     # BLOCK_M: The thread block size across the seqlen dim of Q.
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     # BLOCK_N: Iterate over BLOCK_N across the seqlen dim of K/V in each thread block.
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     # The below are kernel options that can be applied for certain score_mods,
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     # or involve a numerics vs. perf tradeoff
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     # PRESCALE_QK: Whether to pre-scale QK by 1/sqrt(d) and change of base. Has
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     # about 20% more numerical error, but slightly faster.
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     # ROWS_GUARANTEED_SAFE: Is it guaranteed that at least one value in each row
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     # is not masked out? If so, we can skip an extra safety check
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     # BLOCKS_ARE_CONTIGUOUS: Is it guaranteed that all blocks in the mask are
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     # contiguous? If so, we don't need to do an indirect jump for every block
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     tl.static_assert(SPARSE_Q_BLOCK_SIZE >= BLOCK_M and SPARSE_Q_BLOCK_SIZE % BLOCK_M == 0)
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     tl.static_assert(SPARSE_KV_BLOCK_SIZE >= BLOCK_N and SPARSE_KV_BLOCK_SIZE % BLOCK_N == 0)
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     # Define strides of inputs
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     stride_qz, stride_qh, stride_qm, stride_qk = 786432, 32768, 32, 1
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     stride_kz, stride_kh, stride_kn, stride_kk = 262144, 32768, 32, 1
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     stride_vz, stride_vh, stride_vn, stride_vk = 262144, 32768, 32, 1
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     ZQ = 8
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     HQ = 24
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     Q_LEN = 1024
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     ZKV = 8
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     KV_LEN = 1024
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     MATMUL_PRECISION = Q.dtype.element_ty
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     q_start = tl.program_id(0)
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     off_zq = tl.program_id(1) // HQ
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     off_hq = tl.program_id(1) % HQ
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     # We support two cases for batch dimension. a) (ZKV == ZQ) where off_zkv = off_zq.
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     # b) (ZKV == 1 and ZQ > 1) where KV is broadcasted along the batch dimension and off_zkv=0.
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     off_zkv = off_zq % ZKV
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     off_hkv = off_hq // GQA_SHARED_HEADS
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     off_g = off_hq % GQA_SHARED_HEADS
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     q_offset = off_zq * stride_qz + off_hq * stride_qh
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     k_offset = off_zkv * stride_kz + off_hkv * stride_kh
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     v_offset = off_zkv * stride_vz + off_hkv * stride_vh
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     Q = Q + q_offset
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     K = K + k_offset
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     V = V + v_offset
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     SPARSE_Z = 8
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     SPARSE_HQ = 24
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     sparse_idx_z = off_zq % SPARSE_Z
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     sparse_idx_hq = off_hq % SPARSE_HQ
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     SPARSE_Q_MULTIPLE: tl.constexpr = (SPARSE_Q_BLOCK_SIZE // BLOCK_M)
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     SPARSE_KV_MULTIPLE: tl.constexpr = (SPARSE_KV_BLOCK_SIZE // BLOCK_N)
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     stride_kv_num_blks_h = 8
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     stride_kv_idx_h = 64
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     stride_kv_idx_m = 8
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     # initialize pointer to m and l
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     m_i = tl.zeros([BLOCK_M], dtype=tl.float32) - float("inf")
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     l_i = tl.zeros([BLOCK_M], dtype=tl.float32)
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     acc = tl.zeros([BLOCK_M, V_HEAD_DIM_ROUNDED], dtype=tl.float32)
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank5]:E0211 11:43:16.742000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]     offs_m = q_start * BLOCK_M + tl.arange(0, BLOCK_M)
