[rank6]:E0211 11:43:16.656000 2379620 torch/_inductor/runtime/triton_heuristics.py:515]     # z: Batch size, h: Number of heads, m: Number of queries per head, k: Number of keys per head
[rank2]:E0211 11:43:16.646000 123111 torch/_inductor/runtime/triton_heuristics.py:515]     # contiguous? If so, we don't need to do an indirect jump for every block
