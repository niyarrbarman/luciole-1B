[rank4]:E0211 11:43:16.607000 3173919 torch/_inductor/runtime/triton_heuristics.py:515]     # Define strides of inputs
[rank4]:E0211 11:43:16.607000 3173919 torch/_inductor/runtime/triton_heuristics.py:515]     stride_qz, stride_qh, stride_qm, stride_qk = 786432, 32768, 32, 1
[rank4]:E0211 11:43:16.607000 3173919 torch/_inductor/runtime/triton_heuristics.py:515]     stride_kz, stride_kh, stride_kn, stride_kk = 262144, 32768, 32, 1
[rank4]:E0211 11:43:16.607000 3173919 torch/_inductor/runtime/triton_heuristics.py:515]     stride_vz, stride_vh, stride_vn, stride_vk = 262144, 32768, 32, 1
