[rank1]:E0211 11:43:16.685000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     # Sub notation for this kernel:
[rank1]:E0211 11:43:16.685000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     #
[rank1]:E0211 11:43:16.685000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     # Q: Query, K: Key, V: Value
[rank1]:E0211 11:43:16.685000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     # M: Number of queries, N: Number of keys/values, D: Model dimension
[rank1]:E0211 11:43:16.685000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     # QK_HEAD_DIM: The dimension of the query and key embeddings
[rank1]:E0211 11:43:16.685000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     # V_HEAD_DIM: The dimension of the value embeddings
[rank1]:E0211 11:43:16.685000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     # z: Batch size, h: Number of heads, m: Number of queries per head, k: Number of keys per head
[rank1]:E0211 11:43:16.685000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     # GQA_SHARED_HEADS: number of query heads sharing one kv head in GQA setups.
[rank1]:E0211 11:43:16.685000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     #
[rank1]:E0211 11:43:16.685000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     # The following FULL_* and PARTIAL_* is defined in the block sparse mask grid, rather than the thread block grid.
[rank1]:E0211 11:43:16.685000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     # KV_NUM_BLKS: The number of KV blocks (that may or may not require masking) for each query.
[rank1]:E0211 11:43:16.685000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     # KV_IDX: The indices of KV blocks (that may or may not require masking) for each query.
