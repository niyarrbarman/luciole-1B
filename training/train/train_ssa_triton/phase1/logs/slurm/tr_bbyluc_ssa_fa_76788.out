[rank7]:E0211 11:43:16.757000 2379621 torch/_inductor/runtime/triton_heuristics.py:515]     ZQ = 8
[rank7]:E0211 11:43:16.757000 2379621 torch/_inductor/runtime/triton_heuristics.py:515]     HQ = 24
[rank7]:E0211 11:43:16.757000 2379621 torch/_inductor/runtime/triton_heuristics.py:515]     Q_LEN = 1024
[rank7]:E0211 11:43:16.757000 2379621 torch/_inductor/runtime/triton_heuristics.py:515]     ZKV = 8
[rank7]:E0211 11:43:16.757000 2379621 torch/_inductor/runtime/triton_heuristics.py:515]     KV_LEN = 1024
