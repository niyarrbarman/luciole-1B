[rank7]:E0211 11:43:16.697000 2379621 torch/_inductor/runtime/triton_heuristics.py:515]     q_offset = off_zq * stride_qz + off_hq * stride_qh
[rank7]:E0211 11:43:16.697000 2379621 torch/_inductor/runtime/triton_heuristics.py:515]     k_offset = off_zkv * stride_kz + off_hkv * stride_kh
[rank7]:E0211 11:43:16.697000 2379621 torch/_inductor/runtime/triton_heuristics.py:515]     v_offset = off_zkv * stride_vz + off_hkv * stride_vh
[rank7]:E0211 11:43:16.697000 2379621 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank7]:E0211 11:43:16.697000 2379621 torch/_inductor/runtime/triton_heuristics.py:515]     Q = Q + q_offset
[rank7]:E0211 11:43:16.697000 2379621 torch/_inductor/runtime/triton_heuristics.py:515]     K = K + k_offset
[rank7]:E0211 11:43:16.697000 2379621 torch/_inductor/runtime/triton_heuristics.py:515]     V = V + v_offset
[rank7]:E0211 11:43:16.697000 2379621 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank7]:E0211 11:43:16.697000 2379621 torch/_inductor/runtime/triton_heuristics.py:515]     SPARSE_Z = 8
[rank7]:E0211 11:43:16.697000 2379621 torch/_inductor/runtime/triton_heuristics.py:515]     SPARSE_HQ = 24
[rank7]:E0211 11:43:16.697000 2379621 torch/_inductor/runtime/triton_heuristics.py:515] 
