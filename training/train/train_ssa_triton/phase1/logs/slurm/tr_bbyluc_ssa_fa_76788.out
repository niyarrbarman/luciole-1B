[rank0]:E0211 11:43:16.585000 1374095 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank0]:E0211 11:43:16.585000 1374095 torch/_inductor/runtime/triton_heuristics.py:515]     tl.static_assert(SPARSE_Q_BLOCK_SIZE >= BLOCK_M and SPARSE_Q_BLOCK_SIZE % BLOCK_M == 0)
