[rank1]:E0211 11:43:16.577000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     # is not masked out? If so, we can skip an extra safety check
[rank1]:E0211 11:43:16.577000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     # BLOCKS_ARE_CONTIGUOUS: Is it guaranteed that all blocks in the mask are
[rank1]:E0211 11:43:16.577000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     # contiguous? If so, we don't need to do an indirect jump for every block
[rank1]:E0211 11:43:16.577000 1374096 torch/_inductor/runtime/triton_heuristics.py:515] 
[rank1]:E0211 11:43:16.577000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     tl.static_assert(SPARSE_Q_BLOCK_SIZE >= BLOCK_M and SPARSE_Q_BLOCK_SIZE % BLOCK_M == 0)
[rank1]:E0211 11:43:16.577000 1374096 torch/_inductor/runtime/triton_heuristics.py:515]     tl.static_assert(SPARSE_KV_BLOCK_SIZE >= BLOCK_N and SPARSE_KV_BLOCK_SIZE % BLOCK_N == 0)
