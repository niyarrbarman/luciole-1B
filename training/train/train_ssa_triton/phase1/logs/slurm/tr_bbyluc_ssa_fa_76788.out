[rank5]:E0211 11:43:16.702000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]         shape=(QK_HEAD_DIM, KV_LEN),
[rank5]:E0211 11:43:16.702000 3173920 torch/_inductor/runtime/triton_heuristics.py:515]         strides=(stride_kk, stride_kn),
